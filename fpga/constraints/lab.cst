// Board IO from current main project and Dock31005 pin reference.
IO_LOC "sys_clk" V22;
IO_PORT "sys_clk" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_LOC "keys_n[0]" AA13;
IO_LOC "keys_n[1]" AB13;
IO_LOC "keys_n[2]" Y12;
IO_PORT "keys_n[0]" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_PORT "keys_n[1]" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_PORT "keys_n[2]" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
// Reuse the main project's tested MIDI_DEBUG_TX pad and electrical settings.
IO_LOC "MIDI_DEBUG_TX" U15;
IO_PORT "MIDI_DEBUG_TX" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
// Main-project WS2812B data pad, verified there as MIDI_STATUS_LED.
IO_LOC "MIDI_STATUS_LED" J16;
IO_PORT "MIDI_STATUS_LED" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
// Mandatory direct AE350 CORE_CLK PLL placement, MUG1031 section 8.4.1.
INS_LOC "u_core_pll/u_pll/PLL_inst" PLL_R[0];
IO_LOC "tmds_clk_p" G15;
IO_LOC "tmds_clk_n" G16;
IO_LOC "tmds_data_p[0]" J14;
IO_LOC "tmds_data_n[0]" H14;
IO_LOC "tmds_data_p[1]" J15;
IO_LOC "tmds_data_n[1]" H15;
IO_LOC "tmds_data_p[2]" K17;
IO_LOC "tmds_data_n[2]" J17;
IO_PORT "tmds_clk_p" IO_TYPE=LVCMOS33D DRIVE=8 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_PORT "tmds_clk_n" IO_TYPE=LVCMOS33D DRIVE=8 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_PORT "tmds_data_p[0]" IO_TYPE=LVCMOS33D DRIVE=8 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_PORT "tmds_data_n[0]" IO_TYPE=LVCMOS33D DRIVE=8 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_PORT "tmds_data_p[1]" IO_TYPE=LVCMOS33D DRIVE=8 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_PORT "tmds_data_n[1]" IO_TYPE=LVCMOS33D DRIVE=8 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_PORT "tmds_data_p[2]" IO_TYPE=LVCMOS33D DRIVE=8 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_PORT "tmds_data_n[2]" IO_TYPE=LVCMOS33D DRIVE=8 PULL_MODE=NONE BANK_VCCIO=3.3;
