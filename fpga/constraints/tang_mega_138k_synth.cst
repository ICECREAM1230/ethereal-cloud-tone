IO_LOC  "sys_clk"   V22;
IO_PORT "sys_clk"   IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_LOC  "sys_rst_n" AA13;
IO_PORT "sys_rst_n" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;

// Local power-up chord control: Key0 toggle, Key1 stop (active low).
IO_LOC  "Key_in[1]" Y12;
IO_LOC  "Key_in[0]" AB13;
IO_PORT "Key_in[1]" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_PORT "Key_in[0]" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;

// GPIO-to-ball mapping corrected by the user on 2026-10-11; Bank 4, 3.3 V.
// GPIO21/J8.6 -> AB20 CS, GPIO47/J8.5 -> AA19 SCLK,
// GPIO13/J8.8 -> AA21 MOSI, GPIO14/J8.7 <- AA20 MISO.
// Single-ended SPI mode 0; P/N route pairing does not imply LVDS.
IO_LOC  "ESP_SPI_SCLK" AA19;
IO_LOC  "ESP_SPI_CS_N" AB20;
IO_LOC  "ESP_SPI_MOSI" AA21;
IO_LOC  "ESP_SPI_MISO" AA20;
IO_PORT "ESP_SPI_SCLK" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_PORT "ESP_SPI_CS_N" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_PORT "ESP_SPI_MOSI" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_PORT "ESP_SPI_MISO" IO_TYPE=LVCMOS33 DRIVE=8 BANK_VCCIO=3.3;

// Reserve unused adapter routes as input-only, without internal pulls.
// The new adapter does not connect GPIO19/20 USB or GPIO0 BOOT to FPGA.
IO_LOC  "ESP_PMOD1_PASSIVE[0]" AB22; // J8.10 GPIO12
IO_LOC  "ESP_PMOD1_PASSIVE[1]" AB21; // J8.9  GPIO11
IO_LOC  "ESP_PMOD1_PASSIVE[2]" Y22;  // J8.12 GPIO10
IO_LOC  "ESP_PMOD1_PASSIVE[3]" Y21;  // J8.11 GPIO9
IO_PORT "ESP_PMOD1_PASSIVE[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_PORT "ESP_PMOD1_PASSIVE[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_PORT "ESP_PMOD1_PASSIVE[2]" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_PORT "ESP_PMOD1_PASSIVE[3]" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;

// 2026-10-24: ESP32 uses only J8/PMOD1 (the AB21/Y21 group).
// FM diagnostics disabled; retain the previous J9/PMOD0 wiring as comments.
// DISABLED [SYNTH_FM_DIAG_LEDS undefined]: IO_LOC "FM_DIAG_LED[0]" T18; // J9.6
// DISABLED [SYNTH_FM_DIAG_LEDS undefined]: IO_LOC "FM_DIAG_LED[1]" R18; // J9.5
// DISABLED [SYNTH_FM_DIAG_LEDS undefined]: IO_LOC "FM_DIAG_LED[2]" R17; // J9.8
// DISABLED [SYNTH_FM_DIAG_LEDS undefined]: IO_LOC "FM_DIAG_LED[3]" P16; // J9.7
// DISABLED [SYNTH_FM_DIAG_LEDS undefined]: IO_LOC "FM_DIAG_LED[4]" U21; // J9.10
// DISABLED [SYNTH_FM_DIAG_LEDS undefined]: IO_LOC "FM_DIAG_LED[5]" T21; // J9.9
// DISABLED [SYNTH_FM_DIAG_LEDS undefined]: IO_LOC "FM_DIAG_LED[6]" R19; // J9.12
// DISABLED [SYNTH_FM_DIAG_LEDS undefined]: IO_LOC "FM_DIAG_LED[7]" P19; // J9.11
// DISABLED [SYNTH_FM_DIAG_LEDS undefined]: IO_PORT "FM_DIAG_LED[0]" IO_TYPE=LVCMOS33 DRIVE=4 PULL_MODE=NONE BANK_VCCIO=3.3;
// DISABLED [SYNTH_FM_DIAG_LEDS undefined]: IO_PORT "FM_DIAG_LED[1]" IO_TYPE=LVCMOS33 DRIVE=4 PULL_MODE=NONE BANK_VCCIO=3.3;
// DISABLED [SYNTH_FM_DIAG_LEDS undefined]: IO_PORT "FM_DIAG_LED[2]" IO_TYPE=LVCMOS33 DRIVE=4 PULL_MODE=NONE BANK_VCCIO=3.3;
// DISABLED [SYNTH_FM_DIAG_LEDS undefined]: IO_PORT "FM_DIAG_LED[3]" IO_TYPE=LVCMOS33 DRIVE=4 PULL_MODE=NONE BANK_VCCIO=3.3;
// DISABLED [SYNTH_FM_DIAG_LEDS undefined]: IO_PORT "FM_DIAG_LED[4]" IO_TYPE=LVCMOS33 DRIVE=4 PULL_MODE=NONE BANK_VCCIO=3.3;
// DISABLED [SYNTH_FM_DIAG_LEDS undefined]: IO_PORT "FM_DIAG_LED[5]" IO_TYPE=LVCMOS33 DRIVE=4 PULL_MODE=NONE BANK_VCCIO=3.3;
// DISABLED [SYNTH_FM_DIAG_LEDS undefined]: IO_PORT "FM_DIAG_LED[6]" IO_TYPE=LVCMOS33 DRIVE=4 PULL_MODE=NONE BANK_VCCIO=3.3;
