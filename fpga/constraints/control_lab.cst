// PCM5102A A, four-wire standard I2S (BANK2, board VCCIO=3.3V).
// C15/MCK drives DAC SCK; disconnect the DAC's previous SCK-ground strap.
IO_LOC "PCM_WS" C14;
IO_LOC "PCM_DIN" E13;
IO_LOC "PCM_BCK" E14;
IO_LOC "PCM_MCK" C15;
IO_PORT "PCM_WS" IO_TYPE=LVCMOS33 DRIVE=8 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_PORT "PCM_DIN" IO_TYPE=LVCMOS33 DRIVE=8 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_PORT "PCM_BCK" IO_TYPE=LVCMOS33 DRIVE=8 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_PORT "PCM_MCK" IO_TYPE=LVCMOS33 DRIVE=8 PULL_MODE=NONE BANK_VCCIO=3.3;
// PCM5102A B mirrors all four signals from A (BANK4, board VCCIO=3.3V).
// These pins are shared with the SDRAM1/DVP expansion headers.
IO_LOC "PCM_B_WS" R16;
IO_LOC "PCM_B_DIN" R14;
IO_LOC "PCM_B_BCK" P14;
IO_LOC "PCM_B_MCK" P15;
IO_PORT "PCM_B_WS" IO_TYPE=LVCMOS33 DRIVE=8 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_PORT "PCM_B_DIN" IO_TYPE=LVCMOS33 DRIVE=8 PULL_MODE=NONE BANK_VCCIO=3.3;
