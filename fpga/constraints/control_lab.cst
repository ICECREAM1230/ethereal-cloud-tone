// Board IO from current main project and Dock31005 pin reference.
IO_LOC "sys_clk" V22;
IO_PORT "sys_clk" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
// AA13 restores the main project's active-low system-reset button.
// N12 remains the separate device RECONFIG input configured by the project.
IO_LOC "sys_rst_n" AA13;
IO_PORT "sys_rst_n" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
// AB13 reuses the released engine switch for scope/FFT display only.
// Y12 remains released; AA13 above remains the independent system reset.
IO_LOC "display_key_n" AB13;
IO_PORT "display_key_n" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
// Reuse the main project's tested MIDI_DEBUG_TX pad and electrical settings.
IO_LOC "MIDI_DEBUG_TX" U15;
IO_PORT "MIDI_DEBUG_TX" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
// Main-project WS2812B data pad, verified there as MIDI_STATUS_LED.
IO_LOC "MIDI_STATUS_LED" J16;
IO_PORT "MIDI_STATUS_LED" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
// Mandatory direct AE350 CORE_CLK PLL placement, MUG1031 section 8.4.1.
INS_LOC "u_core_pll/u_pll/PLL_inst" PLL_R[0];
// Keep the 14 ITCM address muxes near the fixed AE350 at R0C160.
// PnR185718Z placed them near C3, making ROM_HWRITE cross the fabric twice.
// SUG1541-1.0E section 2.5.1: non-exclusive region, other cells may share it.
GROUP ahb_itcm_addr_near_cpu = {"u_cpu/u_RiscV_AE350_SOC/u_gw_itcm_top/u_gw_itcm/u_ahb_to_ilm/ILMADDR_*_s12"};
GRP_LOC ahb_itcm_addr_near_cpu R[1:12]C[140:179];
// PnR225409Z: pass-count Q at R74C28 drives runtime age logic near R17C16.
// Keep only the existing 16 counter FFs near those consumers; leave the
// increment and drain-control logic free to follow, then inspect their paths.
GROUP sub_pass_count_near_runtime = {"u_system/u_synth_manager/g_subtractive.u_engine/u_pipeline/u_csp/control_pass_count_*_s0"};
GRP_LOC sub_pass_count_near_runtime R[8:34]C[16:50];
// Balance the 5.774 ns wdata30 output route against its CPU input route.
GROUP apb_wdata30_mid = {"u_apb_pipeline/wdata_30_s0"};
GRP_LOC apb_wdata30_mid R[40:56]C[148:166];
