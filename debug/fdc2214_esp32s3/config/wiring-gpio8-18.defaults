# User-confirmed wiring, 2026-10-29. FDC module has external 40 MHz CLKIN
# and existing external pull-ups to 3.3 V. INT is wired to GPIO16 but is
# not driven or required by this STATUS-polling firmware.
CONFIG_FDC_WIRING_CONFIRMED=y
CONFIG_FDC_SDA_GPIO=18
CONFIG_FDC_SCL_GPIO=8
CONFIG_FDC_SD_GPIO=4
CONFIG_FDC_ADDR_GPIO=17
CONFIG_FDC_I2C_ADDRESS=0x2A
# CONFIG_FDC_CLOCK_UNCONFIRMED is not set
CONFIG_FDC_CLOCK_EXTERNAL=y
# CONFIG_FDC_CLOCK_INTERNAL is not set
CONFIG_FDC_EXTERNAL_CLOCK_HZ=40000000
CONFIG_FDC_EXTERNAL_FREF_DIVIDER=1
CONFIG_FDC_I2C_HZ=100000
# Physical Flash capacity was read through esptool before this build.
# CONFIG_ESPTOOLPY_FLASHSIZE_8MB is not set
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.16mb.csv"
