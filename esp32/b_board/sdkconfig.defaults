CONFIG_IDF_TARGET="esp32s3"
CONFIG_B_MIDI_CHANNEL=2
CONFIG_B_DURATION_MIN_MS=20
CONFIG_B_DURATION_MAX_MS=500
CONFIG_B_VELOCITY_MIN=127
CONFIG_B_VELOCITY_MAX=16
CONFIG_B_LASER_ACTIVE_LEVEL=1
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_SPIRAM=n
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=n
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_TINYUSB_MIDI_COUNT=1
CONFIG_TINYUSB_CDC_ENABLED=n
CONFIG_TINYUSB_MSC_ENABLED=n
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=n
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_SECURITY_ENABLE=y
CONFIG_BT_NIMBLE_NVS_PERSIST=n
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_B_ENC1_A=13
CONFIG_B_ENC1_B=14
CONFIG_B_ENC1_SW=12
CONFIG_B_ENC2_A=40
CONFIG_B_ENC2_B=39
CONFIG_B_ENC2_SW=41
CONFIG_B_ENC3_A=47
CONFIG_B_ENC3_B=21
CONFIG_B_ENC3_SW=38
CONFIG_B_ENC4_A=2
CONFIG_B_ENC4_B=42
CONFIG_B_ENC4_SW=1
